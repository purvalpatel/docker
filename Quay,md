## Setup: Quay

Setup with Docker:
----------------
docker-compose.yaml
```
version: "3.8"

services:
  postgres:
    image: postgres:10.12
    container_name: postgresql
    restart: unless-stopped
    environment:
      POSTGRES_DB: quay
      POSTGRES_USER: quayuser
      POSTGRES_PASSWORD: quaypass
    ports:
      - "5433:5432"
    volumes:
      - ./postgresql-backup/postgres:/var/lib/postgresql/data

  redis:
    image: redis:5.0.7
    container_name: redis
    restart: unless-stopped
    command: ["redis-server", "--requirepass", "strongpassword"]
    #ports:
    #  - "6379:6379"
    volumes:
      - ./redis-backup/_data:/data

  quay:
    image: quay.io/projectquay/quay:latest
    container_name: quay
    restart: unless-stopped
    privileged: true
    ports:
      - "8083:8080"
    environment:
      DATABASE_SERVICE_NAME: postgresql
      DATABASE_NAME: quay
      DATABASE_USERNAME: quayuser
      DATABASE_PASSWORD: quaypass
      DATABASE_HOST: postgres
      DATABASE_PORT: 5432
      REDIS_HOST: redis
      REDIS_PASSWORD: redispass
    depends_on:
      - postgres
      - redis
    volumes:
      - ./config-backup/config:/conf/stack
      - ./storage:/datastorage
```

